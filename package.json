{
  "name": "personal-finance-system",
  "version": "0.1.0",
  "private": true,
  "description": "Personal finance ledger based on observed bank email alerts.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*",
    "infrastructure"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "synth": "npm --workspace @finance/infrastructure run synth"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.8"
  }
}
